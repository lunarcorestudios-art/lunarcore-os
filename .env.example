# mock (default) serves the in-repo seed shaped like lunarcore-mcp.
# http calls a BFF. This app never reads ClickUp or Frame.io tokens.
# Shoots and reviews use the same source. http expects /v1/shoots and /v1/reviews.
STUDIO_SOURCE=mock

# Required when STUDIO_SOURCE=http. No trailing path.
# STUDIO_HTTP_BASE_URL=http://localhost:8787

# Optional bearer for the BFF. Not a ClickUp personal token.
# STUDIO_HTTP_TOKEN=

# Shell identity for the mock source. The HTTP bridge uses whoami from the BFF instead.
LUNARCORE_WORKSPACE_NAME=Lunarcore Studios
LUNARCORE_ACTOR_NAME=Lunarcore Operator
LUNARCORE_ACTOR_EMAIL=operator@lunarcore.studio
LUNARCORE_ACTOR_ROLE=producer
